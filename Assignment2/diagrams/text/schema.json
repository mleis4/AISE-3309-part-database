  "constraints": [
    {
      "id": "C1",
      "text": "StarRating is an integer from 1 to 5. Every Quantity is greater than 0. UnitPrice, StockQuantity and ShippingFee are not negative."
    },
    {
      "id": "C2",
      "text": "A distributor has at most one listing for a given part in a given packaging. The same part can be listed several times by one distributor, once per packaging (for example cut tape and reel), and each of those listings has its own Distributor_PartNum, price and stock."
    },
    {
      "id": "C3",
      "text": "A BOM selects only listings of parts it contains, and at most one listing for each of those parts."
    },
    {
      "id": "C4",
      "text": "AlternativeTo is symmetric, and a part is not an alternative to itself."
    },
    {
      "id": "C5",
      "text": "A SharedProject's BOM contains at least one part at all times."
    },
    {
      "id": "C6",
      "text": "A customer reviews a part at most once. Purchases are completed on the distributor's own website, so the system does not record them and cannot check that the reviewer bought the part."
    },
    {
      "id": "C7",
      "text": "The part offered by a listing never changes. An offer for a different part is a new listing."
    }
  ],
  "constraint_maintenance": [
    {
      "rule": "C3",
      "operation": "INSERT or UPDATE on BOMSelection",
      "action": "Rejected unless the listing's part has a BOMLine in the same BOM and the BOM has no other selection for that part."
    },
    {
      "rule": "C3",
      "operation": "DELETE on BOMLine",
      "action": "The BOM's selection for that part, if any, is deleted with the line."
    },
    {
      "rule": "C3, C7",
      "operation": "UPDATE of the part columns of Listing",
      "action": "Rejected when made directly. A listing never changes its part, so an existing selection cannot start pointing at a different part. The one exception is the ON UPDATE CASCADE from Part when a part's own key is corrected: the listing still refers to the same part."
    },
    {
      "rule": "C3",
      "operation": "DELETE on Listing",
      "action": "Its BOMSelection rows are removed by ON DELETE CASCADE. The line stays and counts in /UnpricedParts."
    },
    {
      "rule": "C5",
      "operation": "INSERT on SharedProject",
      "action": "Rejected if the BOM has no BOMLine."
    },
    {
      "rule": "C5",
      "operation": "DELETE on BOMLine",
      "action": "Rejected if it is the last line of a shared BOM. The owner must stop sharing the project first. This applies to deleting a line on its own: when the BOM or its customer is deleted, the lines and the SharedProject row are removed together by the cascades."
    }
  ],
